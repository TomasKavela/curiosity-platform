{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "curiosity-platform",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker/index.ts",

  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },

  // Workers AI â€” sem necessidade de API key, autenticaÃ§Ã£o Ã© o prÃ³prio binding.
  // "remote: true" Ã© obrigatÃ³rio: nÃ£o existe emulaÃ§Ã£o local para Workers AI,
  // a chamada visa sempre a API real da Cloudflare (usa `wrangler login`).
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Base de dados relacional (User, Profile, Exploration, Message, Memory, Idea, Notification).
  // <configure-me>: crie a base com `npx wrangler d1 create curiosity-platform-db`
  // e substitua database_id pelo ID devolvido.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "curiosity-platform-db",
      "database_id": "07c7b78e-5852-485d-bf7c-7ec80c11f0df"
    }
  ],

  // SessÃµes, rate limiting, cache de resumos.
  // <configure-me>: crie com `npx wrangler kv namespace create SESSIONS_KV`
  "kv_namespaces": [
    {
      "binding": "SESSIONS_KV",
      "id": "d1bf63d1e3b946cb9915a576c377caa3"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "ENVIRONMENT": "development"
  }
}
